# TEMPLATE — copy to ".env" next to this file and adjust for the machine you're on.
# .env is gitignored so per-server settings never overwrite each other.

# Where the API listens. 0.0.0.0 = all interfaces, 127.0.0.1 = this PC only.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# Frontend origins allowed to call this API (CORS). Comma-separated, no trailing slash.
# On a real deployment put the public frontend URL here.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# true = also serve the built frontend from this port (single-origin mode).
SERVE_FRONTEND=false

# Development | Production
ASPNETCORE_ENVIRONMENT=Development
