# TEMPLATE — copy to ".env" next to this file and adjust for the machine you're on.
# .env is gitignored so per-server settings never overwrite each other.

# Where the API listens. 0.0.0.0 = all interfaces, 127.0.0.1 = this PC only.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# Frontend origins allowed to call this API (CORS). Comma-separated, no trailing slash.
# On a real deployment put the public frontend URL here.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# true = also serve the built frontend from this port (single-origin mode).
SERVE_FRONTEND=false

# Development | Production
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
#  YouTube import
# ---------------------------------------------------------------------------
# YouTube blocks datacenter IP ranges. A hosted server calling YouTube directly
# fails on EVERY video with "Sign in to confirm you're not a bot" — public videos
# included. The same link works fine from a home connection. So on a server the
# feature only works through a proxy.
#
# Youtube__UseProxy is the master switch:
#   true  -> imports run, every yt-dlp call routed through Youtube__ProxyUrl
#   false -> imports refused immediately with a clear message (no pointless wait)
#
# Locally you can leave this false and use a local instance for imports — your
# home IP is not blocked.
Youtube__UseProxy=false

# Only used when UseProxy=true. Proxy for yt-dlp ONLY — the database, Backblaze B2
# and every API request keep using the server's own connection.
# Prefer socks5h:// over socks5:// so DNS resolves AT the proxy; otherwise the
# lookup leaks out over the blocked connection.
#   socks5h://user:password@host:1080
#   http://user:password@host:port
# CONTAINS CREDENTIALS - keep it out of git; set it as an environment variable.
Youtube__ProxyUrl=

# YtDlp (needs the yt-dlp binary) | YoutubeExplode (pure .NET fallback).
# Note: switching provider does NOT get around the IP block — that is about the
# server's address, not the extractor.
Youtube__Provider=YtDlp
Youtube__YtDlpPath=yt-dlp
Youtube__TimeoutSeconds=90
